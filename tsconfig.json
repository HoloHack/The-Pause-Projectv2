{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": "src",
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
